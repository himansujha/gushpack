# Supabase Configuration
# Replace with your project details from Supabase dashboard (Settings -> API)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"

# Optional client-side Supabase duplicates (if needed for client bundles)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# AI Lead Buddy / Gippi Bot Configuration
# Google Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-3.8-flash"

# Optional OpenAI fallback configuration (if using OpenAI models)
# OPENAI_API_KEY="your-openai-api-key"
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
